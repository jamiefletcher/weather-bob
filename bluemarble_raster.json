{
	"version": 8,
	"name": "gdps",
	"glyphs": "https://jamiefletcher.github.io/weather-bob/assets/fonts/{fontstack}/{range}.pbf",
	"sprite": "https://jamiefletcher.github.io/weather-bob/assets/sprites/sprites-trees",
	"sources": {
		"bluemarble": {
			"type": "raster",
			"tiles": [
				"data/bluemarble/{z}/{x}/{y}.png"
			],
			"tileSize": 256
		},
		"gdps": {
			"type": "raster",
			"tiles": [
				"data/gdps/tiles/{z}/{x}/{y}.png"
			],
			"tileSize": 256
		},		
		"provinces_lines": {
			"type": "vector",
			"tiles": [
				"https://jamiefletcher.github.io/weather-bob/data/naturalearth/provinces_lines/{z}/{x}/{y}.pbf"
			]
		},
		"boundaries": {
			"type": "vector",
			"tiles": [
				"https://jamiefletcher.github.io/weather-bob/data/naturalearth/boundaries/{z}/{x}/{y}.pbf"
			]
		},
		"coastline": {
			"type": "vector",
			"tiles": [
				"https://jamiefletcher.github.io/weather-bob/data/naturalearth/coastline/{z}/{x}/{y}.pbf"
			]
		}		
	},
	"layers": [
		{
			"id": "bluemarble",
			"type": "raster",
			"source": "bluemarble",
			"paint": {
				"raster-saturation": 0.2,
				"raster-contrast": 0.2,
				"raster-brightness-min": 0.2,
		        "raster-brightness-max": 1
			}
		},	
		{
			"id": "provinces-lines",
			"type": "line",
			"source": "provinces_lines",
			"source-layer": "provinces_lines",
			"paint": {
				"line-color": "hsl(210, 15%, 100%)",
				"line-width": 1,
				"line-opacity": 0.5
			}
		},
		{
			"id": "boundaries",
			"type": "line",
			"source": "boundaries",
			"source-layer": "boundaries",
			"paint": {
				"line-color": "hsl(210, 15%, 100%)",
				"line-width": 1,
				"line-opacity": 0.5
			}
		},
		{
			"id": "coastline",
			"type": "line",
			"source": "coastline",
			"source-layer": "coastline",
			"paint": {
				"line-color": "hsl(210, 15%, 100%)",
				"line-width": 1,
				"line-opacity": 0.5
			}
		}							
	]
}