			"paint": {
				"line-color": "hsl(210, 15%, 89%)",
				"line-width": 4
			}
		},
		{
			"id": "railroads_north_america-dash",
			"type": "line",
			"source": "railroads_north_america",
			"source-layer": "railroads_north_america",
			"paint": {
				"line-color": "hsl(210, 15%, 99%)",
				"line-width": 2,
				"line-dasharray": [1.5,1.5]
			}
		},		
		{
			"id": "roads",
			"type": "line",
			"source": "roads",
			"source-layer": "roads",
			"filter": [
				"in",
				"featurecla",
				"Road"
			],
			"paint": {
				"line-color": "hsl(210, 15%, 99%)",
				"line-width": 2
			}
		},
		{
			"id": "roads_north_america",
			"type": "line",
			"source": "roads_north_america",
			"source-layer": "roads_north_america",
			"filter": [
				"in",
				"featurecla",
				"Road"
			],
			"paint": {
				"line-color": "hsl(210, 15%, 99%)",
				"line-width": 1
			}
		},
		{
			"id": "provinces-lines",
			"type": "line",
			"source": "provinces_lines",
			"source-layer": "provinces_lines",
			"paint": {
				"line-color": "hsl(210, 15%, 72%)",
				"line-width": 2,
				"line-dasharray": [2, 1]
			}
		},
		{
			"id": "boundaries",
			"type": "line",
			"source": "boundaries",
			"source-layer": "boundaries",
			"paint": {
				"line-color": "hsl(210, 15%, 72%)",
				"line-width": 2,
				"line-dasharray": [2, 1, 1, 1]
			}
		},
		{
			"id": "lakes-labels",
			"type": "symbol",
			"source": "lakes",
			"source-layer": "lakes",
			"layout": {
				"text-field": [
					"get",
					"name"
				],
				"text-size": 12,
				"text-max-width": 6,
				"text-font": [
					"montserrat-semibold"
				],
				"text-anchor": "center",
				"text-allow-overlap": false,
				"text-ignore-placement": false
			},
			"paint": {
				"text-color": "hsl(205, 45%, 48%)",
				"text-halo-color": "hsl(0, 0%, 100%)",
				"text-halo-width": 1
			}
		}
