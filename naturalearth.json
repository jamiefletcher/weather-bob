			"type": "line",
			"source": "railroads",
			"source-layer": "railroads",
			"paint": {
				"line-color": "hsl(210, 15%, 99%)",
				"line-width": 2,
				"line-dasharray": [1.5,1.5]
			}
		},	
		{
			"id": "railroads_north_america",
			"type": "line",
			"source": "railroads_north_america",
